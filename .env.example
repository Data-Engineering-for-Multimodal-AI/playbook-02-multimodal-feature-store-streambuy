# Settings read from environment variables by the API (src/api/main.py).
# The app doesn't load a .env file itself: export these in your shell, or start
# uvicorn with `--env-file .env` (needs the python-dotenv package).
# The defaults below match docker-compose.yml. They are local development
# credentials for the Docker containers only; don't reuse them anywhere else.

DATABASE_URL=postgresql://user:password@localhost:5432/streambuy_features
MILVUS_HOST=localhost
MILVUS_PORT=19530

# docker-compose.yml reads these. Change POSTGRES_PORT if another PostgreSQL
# already uses 5432 on your machine, and update DATABASE_URL to match.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
